{
  "name": "web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/r3sizer-wasm --target web --out-dir ../../web/src/shared/api/processing/wasm-pkg --no-opt && wasm-opt --enable-simd --enable-bulk-memory --enable-nontrapping-float-to-int -Oz -o src/shared/api/processing/wasm-pkg/r3sizer_wasm_bg.wasm src/shared/api/processing/wasm-pkg/r3sizer_wasm_bg.wasm",
    "typegen": "cargo test -p r3sizer-core --features typegen export_typescript_bindings -- --nocapture",
    "dev": "vite",
    "build": "npm run build:wasm && tsc -b && vite build && cp dist/index.html dist/404.html",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fsd": "steiger ./src",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router": "^1.170.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-wasm": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "steiger": "^0.5.13",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
